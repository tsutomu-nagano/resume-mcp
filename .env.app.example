HASURA_GRAPHQL_ENDPOINT=https://example.com/v1/graphql
HASURA_ADMIN_SECRET=change-me
# HASURA_GRAPHQL_ROLE=

# Generic GraphQL auth is also supported when not using Hasura.
# GRAPHQL_URL=https://example.com/graphql
# GRAPHQL_TOKEN=
# GRAPHQL_API_KEY=
MCP_HOST=0.0.0.0
MCP_PORT=8000
GRAPHQL_TIMEOUT_SECONDS=20

# Optional: set this when exposing resume-mcp through OpenAI tunnel-client.
# CONTROL_PLANE_API_KEY and CONTROL_PLANE_TUNNEL_ID should be placed in .env.tunnel.
# TUNNEL_CLIENT_PROFILE=resume
# TUNNEL_CLIENT_HEALTH_PORT=8080
